{
  "name": "ai-video-story-gen",
  "version": "0.1.0",
  "description": "AI-powered video story generator with TTS and gameplay overlay for Instagram Reels",
  "main": "src/main/index.js",
  "homepage": "./",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build-watch\" \"electron .\"",
    "build": "echo \"Building project...\"",
    "build-watch": "echo \"Watch mode not configured yet\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.32.6",
    "@xenova/transformers": "^2.6.5"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.1"
  },
  "build": {
    "appId": "com.aiVideostoryGen.app",
    "productName": "AI Video Story Gen",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    }
  }
}
